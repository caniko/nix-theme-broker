{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/theme-broker/provider/v1",
  "title": "Theme Broker provider",
  "type": "object",
  "required": ["schema", "id", "name", "description", "provenance", "defaults", "variants"],
  "properties": {
    "schema": {"const": "theme-broker.provider/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["repository", "revision", "license"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "required": ["variant"],
      "properties": {
        "variant": {"type": "string"},
        "accent": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/variant"}
    }
  },
  "$defs": {
    "figure": {
      "description": "Optional figure/chart palette: scalar colours, a 10-colour categorical cycle, matplotlib colormap names and a time_range sub-interval.",
      "type": "object",
      "required": ["background", "surface", "surface_alt", "border", "ink", "muted", "link", "accent", "positive", "negative", "highlight", "on_status", "true_mask", "false_mask", "unavailable", "point", "box_fill", "reference", "categorical", "sequential_cmap", "density_cmap", "time_cmap", "time_range"],
      "properties": {
        "background": {"$ref": "#/$defs/colorValue"},
        "surface": {"$ref": "#/$defs/colorValue"},
        "surface_alt": {"$ref": "#/$defs/colorValue"},
        "border": {"$ref": "#/$defs/colorValue"},
        "ink": {"$ref": "#/$defs/colorValue"},
        "muted": {"$ref": "#/$defs/colorValue"},
        "link": {"$ref": "#/$defs/colorValue"},
        "accent": {"$ref": "#/$defs/colorValue"},
        "positive": {"$ref": "#/$defs/colorValue"},
        "negative": {"$ref": "#/$defs/colorValue"},
        "highlight": {"$ref": "#/$defs/colorValue"},
        "on_status": {"$ref": "#/$defs/colorValue"},
        "true_mask": {"$ref": "#/$defs/colorValue"},
        "false_mask": {"$ref": "#/$defs/colorValue"},
        "unavailable": {"$ref": "#/$defs/colorValue"},
        "point": {"$ref": "#/$defs/colorValue"},
        "box_fill": {"$ref": "#/$defs/colorValue"},
        "reference": {"$ref": "#/$defs/colorValue"},
        "categorical": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/colorValue"}},
        "sequential_cmap": {"type": "string", "minLength": 1},
        "density_cmap": {"type": "string", "minLength": 1},
        "time_cmap": {"type": "string", "minLength": 1},
        "time_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^#?[0-9A-Fa-f]{6}$"
    },
    "colorValue": {
      "oneOf": [
        {"$ref": "#/$defs/color"},
        {"type": "string", "pattern": "^@[A-Za-z0-9_-]+$"},
        {"$ref": "#/$defs/richColor"}
      ]
    },
    "richColor": {
      "type": "object",
      "required": ["hex"],
      "properties": {
        "hex": {"$ref": "#/$defs/color"},
        "hsl": {},
        "oklch": {},
        "sourceName": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "colorMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/colorValue"}
    },
    "variant": {
      "type": "object",
      "required": ["metadata", "named", "roles", "ansi", "base16"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["appearance", "contrast"],
          "properties": {
            "appearance": {"enum": ["dark", "light"]},
            "contrast": {"enum": ["hard", "medium", "soft"]}
          },
          "additionalProperties": true
        },
        "named": {"$ref": "#/$defs/colorMap"},
        "roles": {"type": "object", "properties": {"figure": {"$ref": "#/$defs/figure"}}},
        "accents": {"$ref": "#/$defs/colorMap"},
        "accentBindings": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
        "ansi": {
          "type": "object",
          "required": ["normal", "bright"],
          "properties": {
            "normal": {"$ref": "#/$defs/ansiMap"},
            "bright": {"$ref": "#/$defs/ansiMap"}
          },
          "additionalProperties": true
        },
        "base16": {"$ref": "#/$defs/base16"},
        "base24": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "ansiMap": {
      "type": "object",
      "required": ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"],
      "additionalProperties": {"$ref": "#/$defs/colorValue"}
    },
    "base16": {
      "type": "object",
      "required": ["base00", "base01", "base02", "base03", "base04", "base05", "base06", "base07", "base08", "base09", "base0A", "base0B", "base0C", "base0D", "base0E", "base0F"],
      "additionalProperties": {"$ref": "#/$defs/colorValue"}
    }
  },
  "additionalProperties": true
}
