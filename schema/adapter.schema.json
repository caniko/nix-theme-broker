{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/theme-broker/adapter/v1",
  "title": "Theme Broker native adapter",
  "type": "object",
  "required": ["schema", "id", "provider", "target", "platforms", "provenance", "capabilities"],
  "properties": {
    "schema": {"const": "theme-broker.adapter/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "provider": {"type": "string"},
    "target": {"type": "string"},
    "platforms": {"type": "array", "items": {"enum": ["homeManager", "nixos", "darwin"]}, "minItems": 1},
    "priority": {"type": "integer"},
    "autoSafe": {"type": "boolean"},
    "class": {"enum": ["simple", "complex"]},
    "optionPath": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "optionValues": {"type": "object"},
    "module": {"type": "string", "minLength": 1},
    "rendererKind": {"enum": ["simple", "vscode-profile", "firefox-profile", "gruvbox-vim", "gruvbox-neovim", "gruvbox-vscode", "gruvbox-cursors"]},
    "provenance": {
      "type": "object",
      "required": ["tier", "repository", "revision", "license"],
      "properties": {
        "tier": {"enum": ["official", "canonical", "maintained", "community", "local"]},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string"},
        "license": {"type": "string"}
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "variants": {
          "oneOf": [
            {"const": "all"},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "accent": {"enum": ["none", "exact", "all"]},
        "namedOverrides": {"type": "boolean"},
        "roleOverrides": {"type": "boolean"},
        "transparency": {"type": "boolean"},
        "exact": {"type": "boolean"},
        "nativeOptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "profiles": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"required": ["class"]},
      "then": {
        "oneOf": [
          {"properties": {"class": {"const": "simple"}}, "required": ["optionPath"]},
          {"properties": {"class": {"const": "complex"}}}
        ]
      }
    },
    {"if": {"required": ["optionPath"]}, "then": {"required": ["class"]}},
    {
      "if": {
        "properties": {"rendererKind": {"const": "simple"}},
        "required": ["rendererKind"]
      },
      "then": {
        "not": {"properties": {"class": {"const": "complex"}}},
        "required": ["optionPath"]
      }
    },
    {"if": {"required": ["optionValues"]}, "then": {"required": ["optionPath"]}},
    {
      "if": {
        "properties": {
          "rendererKind": {
            "enum": ["vscode-profile", "firefox-profile", "gruvbox-vim", "gruvbox-neovim", "gruvbox-vscode", "gruvbox-cursors"]
          }
        },
        "required": ["rendererKind"]
      },
      "then": {
        "properties": {"class": {"const": "complex"}},
        "required": ["class"]
      }
    },
    {
      "if": {
        "properties": {
          "rendererKind": {
            "enum": ["vscode-profile", "firefox-profile", "gruvbox-vim", "gruvbox-neovim", "gruvbox-vscode", "gruvbox-cursors"]
          }
        },
        "required": ["rendererKind"]
      },
      "then": {
        "oneOf": [
          {"properties": {"rendererKind": {"const": "vscode-profile"}, "id": {"const": "catppuccin-antigravity"}, "provider": {"const": "catppuccin"}, "target": {"const": "antigravity"}}},
          {"properties": {"rendererKind": {"const": "vscode-profile"}, "id": {"const": "catppuccin-cursor"}, "provider": {"const": "catppuccin"}, "target": {"const": "cursor"}}},
          {"properties": {"rendererKind": {"const": "vscode-profile"}, "id": {"const": "catppuccin-kiro"}, "provider": {"const": "catppuccin"}, "target": {"const": "kiro"}}},
          {"properties": {"rendererKind": {"const": "vscode-profile"}, "id": {"const": "catppuccin-vscode"}, "provider": {"const": "catppuccin"}, "target": {"const": "vscode"}}},
          {"properties": {"rendererKind": {"const": "vscode-profile"}, "id": {"const": "catppuccin-vscodium"}, "provider": {"const": "catppuccin"}, "target": {"const": "vscodium"}}},
          {"properties": {"rendererKind": {"const": "vscode-profile"}, "id": {"const": "catppuccin-windsurf"}, "provider": {"const": "catppuccin"}, "target": {"const": "windsurf"}}},
          {"properties": {"rendererKind": {"const": "firefox-profile"}, "id": {"const": "catppuccin-firefox"}, "provider": {"const": "catppuccin"}, "target": {"const": "firefox"}}},
          {"properties": {"rendererKind": {"const": "gruvbox-cursors"}, "id": {"const": "gruvbox-cursors"}, "provider": {"const": "gruvbox"}, "target": {"const": "cursors"}}},
          {"properties": {"rendererKind": {"const": "gruvbox-neovim"}, "id": {"const": "gruvbox-neovim"}, "provider": {"const": "gruvbox"}, "target": {"const": "neovim"}}},
          {"properties": {"rendererKind": {"const": "gruvbox-vim"}, "id": {"const": "gruvbox-vim"}, "provider": {"const": "gruvbox"}, "target": {"const": "vim"}}},
          {"properties": {"rendererKind": {"const": "gruvbox-vscode"}, "id": {"const": "gruvbox-vscode"}, "provider": {"const": "gruvbox"}, "target": {"const": "vscode"}}}
        ]
      }
    },
    {
      "if": {
        "properties": {
          "rendererKind": {"enum": ["vscode-profile", "firefox-profile"]}
        },
        "required": ["rendererKind"]
      },
      "then": {
        "properties": {
          "capabilities": {"properties": {"profiles": {"const": true}}, "required": ["profiles"]}
        },
        "required": ["class"]
      }
    }
  ],
  "additionalProperties": true
}
